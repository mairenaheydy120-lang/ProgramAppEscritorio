<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AgroStock</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Proveedor ADO.NET para SQLite (Microsoft) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- El script se copia junto al .exe para crear la base la primera vez -->
    <None Include="..\agrostock.sql" Link="agrostock.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
